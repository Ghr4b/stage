# Local development reference. Production Compose settings live in deploy/compose/.env.example.
DATABASE_URL=postgres://tijeri:<generated-password>@localhost:5433/tijeri?sslmode=disable
NATS_URL=nats://localhost:4222
DEFECTDOJO_URL=http://localhost:8081
DTRACK_URL=http://localhost:8082
OBJECT_STORE_DIR=/tmp/tijeri-objectstore
API_ADDR=:8080
TIJERI_API_TOKEN=
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_SESSION_SECRET=
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUPS=
OIDC_OPERATOR_GROUPS=
OIDC_VIEWER_GROUPS=
TLS_REQUIRED=false
TLS_CERT=
TLS_KEY=
DISCOVER_ALLOWLIST=
SCAN_MAX_WORKERS=
SCAN_RESERVED_MEMORY_MB=512
SCAN_MEMORY_PER_WORKER_MB=768
MIGRATIONS_DIR=migrations
