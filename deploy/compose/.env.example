# Copy to deploy/compose/.env and restrict access: chmod 600 deploy/compose/.env.
# Generate password/token values with: openssl rand -hex 32
POSTGRES_PASSWORD=
TIJERI_DATABASE_PASSWORD=
DD_DATABASE_PASSWORD=
DTRACK_DATABASE_PASSWORD=
DD_SECRET_KEY=
DD_AES_KEY=
DD_ADMIN_PASSWORD=
TIJERI_API_TOKEN=
# Generate with: install -d -m 700 deploy/compose/secrets; umask 077; openssl rand -hex 32 > deploy/compose/secrets/wazuh-indexer-password
# Set the absolute path to that private file below; never commit the secret.
WAZUH_INDEXER_PASSWORD_FILE=
# HTTPS URL reachable from Wazuh; hostname must match the Tijeri certificate SAN.
TIJERI_WAZUH_WEBHOOK_URL=
# Absolute path to the CA certificate that issued the Tijeri HTTPS certificate.
TIJERI_CA_CERT_FILE=
NATS_USER=tijeri
NATS_PASSWORD=

# Configure an OIDC application in your identity provider and allow this exact callback URL.
OIDC_ENABLED=true
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://your-tijeri-host:8080/auth/callback
OIDC_SESSION_SECRET=
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUPS=
OIDC_OPERATOR_GROUPS=
OIDC_VIEWER_GROUPS=

# Pin all DefectDojo containers to the same reviewed release tag.
DEFECTDOJO_VERSION=
DD_ALLOWED_HOSTS=localhost,127.0.0.1,defectdojo-nginx,tijeri-orchestrator

# Set these to absolute paths for a company-trusted certificate and private key.
TLS_CERT_FILE=
TLS_KEY_FILE=
TIJERI_SERVER_NAME=

# Comma-separated CIDRs approved by the network/security owner; do not use 0.0.0.0/0.
DISCOVER_ALLOWLIST=

# Create a least-privilege API key in Dependency-Track before starting Tijeri.
DTRACK_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
GVM_ADDR=unix:///var/run/gvmd.sock
GVM_USERNAME=
GVM_PASSWORD=
GVM_SOCKET=

# Blank SCAN_MAX_WORKERS lets Tijeri choose a conservative CPU/cgroup-memory limit.
SCAN_MAX_WORKERS=
SCAN_RESERVED_MEMORY_MB=512
SCAN_MEMORY_PER_WORKER_MB=768
TIJERI_MEMORY_LIMIT=4g

# Optional lab-only Vault development token. Never enable the lab secrets profile in production.
VAULT_DEV_ROOT_TOKEN_ID=
