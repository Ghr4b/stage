{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "finding_id": { "type": "string" },
    "asset_id": { "type": "string" },
    "source_tool": { "type": "string" },
    "vulnerability_id": { "type": "string" },
    "component": { "type": "string" },
    "component_version": { "type": "string" },
    "cvss": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "score": { "type": "number" },
            "version": { "type": "string" },
            "vector": { "type": "string" },
            "source": { "type": ["string", "null"], "enum": ["NVD", "CNA", "ADP", null] }
          },
          "required": ["score", "version", "vector", "source"]
        }
      ]
    },
    "nvd_enrichment_status": {
      "type": "string",
      "enum": ["full", "lowest_priority", "not_scheduled"]
    },
    "epss": {
      "type": "object",
      "properties": {
        "score": { "type": "number" },
        "percentile": { "type": "number" }
      },
      "required": ["score", "percentile"]
    },
    "kev_listed": { "type": "boolean" },
    "ssvc": {
      "type": ["string", "null"],
      "enum": ["track", "track_star", "attend", "act", null]
    },
    "vex_status": {
      "type": ["string", "null"],
      "enum": ["not_affected", "affected", "fixed", "under_investigation", null]
    },
    "vex_justification": {
      "type": ["string", "null"]
    },
    "first_seen": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["open", "resolved", "reopened", "accepted_risk", "suppressed_vex"]
    },
    "dedup_hash": { "type": "string" }
  },
  "required": [
    "finding_id", "asset_id", "source_tool", "vulnerability_id", "component", "component_version",
    "cvss", "nvd_enrichment_status", "epss", "kev_listed", "ssvc", "vex_status", "first_seen", "last_seen", "status", "dedup_hash"
  ]
}
